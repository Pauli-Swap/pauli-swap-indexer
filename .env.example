# Copy to .env; docker compose reads it.

# gqrl JSON-RPC. On the VPS: the node next to the indexer (see the note in
# docker-compose.yml). For local development without the SSH tunnel, the public
# devnet proxy works for a small devnet:
#   RPC_URL=https://app.quantumark.fi/rpc/private-testnet
RPC_URL=http://host.docker.internal:8545

POSTGRES_PASSWORD=change-me

# Blocks behind head before a block is indexed (2-4, never 0).
CONFIRMATIONS=3
LOG_RANGE=20000
POLL_MS=4000
# A pool prices tokens, and counts as tracked volume, only with at least this
# much QRL on each side. Changing it (or BRIDGE_TOKENS / STABLE_TOKENS)
# rebuilds the index on the next start.
MIN_QRL_LIQUIDITY=1
# Tokens besides WQRL and STABLE_TOKENS that may carry a price on to others.
BRIDGE_TOKENS=

# USD (docs/INDEXER.md §9). none: every USD field is null; the only right
# setting on the devnet, whose QRL and QUSD have no market value.
#   feed:   QRL/USD from USD_FEED (coingecko or mexc), polled every
#           USD_FEED_MINUTES and backfilled hourly; older than
#           USD_FEED_MAX_AGE_HOURS counts as no price.
#   stable: QRL/USD from the deepest WQRL / STABLE_TOKENS pool holding at
#           least MIN_USD_LIQUIDITY of the stablecoin. With USD_FEED set too,
#           USD is hidden while the two differ by more than USD_MAX_DEVIATION.
USD_SOURCE=none
USD_FEED=
USD_FEED_MINUTES=5
USD_FEED_MAX_AGE_HOURS=6
STABLE_TOKENS=
MIN_USD_LIQUIDITY=10000
USD_MAX_DEVIATION=0.05

# Retention: hour rollups kept this many days; events kept forever when 0.
HOUR_DATA_DAYS=90
EVENT_DAYS=0

# Season eligibility: active UTC days and markets traded in the season
# (docs/INDEXER.md §8.8). The proposed season 1 rules, still to be confirmed.
PREDICT_MIN_DAYS=7
PREDICT_MIN_MARKETS=3

# quests/denylist.json of pauli-swap-prediction-market. questProgress reports
# `denied` for its wallets so the interface does not wait for a credit that
# never comes. Re-read when the file changes. Empty: nobody is denied.
DENYLIST_PATH=

# Ingest pauses when the Postgres volume has less free space than this.
DISK_MIN_FREE_GB=5

# Who may call the API from a browser. Use the interface's origin in production.
CORS_ORIGIN=*

# The API port is published on this address only (nginx in front on the VPS).
API_BIND=127.0.0.1
API_PORT=4000
