{
  "name": "pauli-swap-indexer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "license": "GPL-3.0-or-later",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/main.js",
    "dev": "tsx src/main.ts",
    "migrate": "tsx src/cli.ts migrate",
    "reindex": "tsx src/cli.ts reindex",
    "audit": "tsx scripts/audit.ts",
    "sync:contracts": "node scripts/sync-contracts.mjs ../pauli-swap",
    "sync:lib": "node scripts/sync-lib.mjs ../pauli-swap-interface",
    "sync:predict": "node scripts/sync-predict.mjs ../pauli-swap-prediction-market",
    "predict:sybil": "tsx src/cli.ts sybil"
  },
  "dependencies": {
    "@theqrl/web3": "1.0.3",
    "graphql": "16.14.2",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "tsx": "4.23.15",
    "typescript": "5.6.3"
  }
}
